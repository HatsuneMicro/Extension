root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.js]
max_line_length = 100
quote_type = single
ij_javascript_use_double_quotes = false

[*.{test.js}]
max_line_length = 120

[*.{html,css,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.svg]
indent_style = space
indent_size = 2
